# --- Backend interne ---
# Adresse du service backend, jamais exposée au navigateur — proxyée en
# interne par src/app/api/[...path]/route.ts et src/app/about.json/route.ts.
# En Docker, docker-compose.yml la surcharge avec "http://backend:3002"
# (nom du service sur le réseau interne). En dev local (hors Docker), pointe
# vers le port du backend sur l'host.
BACKEND_INTERNAL_URL="http://localhost:3002"
