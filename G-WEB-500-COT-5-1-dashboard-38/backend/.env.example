# --- Base de données ---
# L'hôte "db" correspond au nom du service postgres dans docker-compose.yml.
DATABASE_URL="postgresql://dashboard:dashboard@db:5432/dashboard?schema=public"

# --- Authentification (NextAuth.js) ---
# URL PUBLIQUE de l'app (celle du navigateur) — servie par le service frontend,
# jamais par ce service directement. Sert à générer les URLs de callback/
# redirection OAuth, pas à joindre ce conteneur (qui n'est jamais exposé).
NEXTAUTH_URL="http://localhost:8080"
# Clé secrète de session. Génération : openssl rand -base64 32
# (en Docker, laissée vide, elle est générée au premier démarrage : cf. docker-entrypoint.sh)
NEXTAUTH_SECRET=

# --- OAuth GitHub (NextAuth.js) ---
# Le provider GitHub est activé uniquement lorsque les deux variables sont renseignées.
# Créer une OAuth App : GitHub > Settings > Developer settings > OAuth Apps.
# Callback URL en développement : http://localhost:3001/api/auth/callback/github
# Homepage URL : http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth Google (NextAuth.js) ---
# Le provider Google est activé uniquement lorsque les deux variables sont renseignées.
# Créer les identifiants : console.cloud.google.com > API et services > Identifiants
# > Créer des identifiants > ID client OAuth (type "Application Web").
# Redirect URI en développement : http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chiffre access_token/refresh_token en base (Account.access_token/refresh_token) —
# jamais stockés en clair. Clé dédiée, différente de NEXTAUTH_SECRET (usages séparés :
# signer des JWT vs chiffrer des secrets, un secret compromis ne doit pas casser l'autre).
# Génération : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Steam ---
# Optionnelle : sans elle, chaque utilisateur saisit sa propre clé en connectant
# Steam sur la page Services. Clé gratuite : https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# --- YouTube ---
# Clé serveur optionnelle des widgets YouTube (YouTube Data API v3 activée sur
# console.cloud.google.com). Sans elle, chaque utilisateur saisit la sienne en
# connectant YouTube sur la page Services.
# YOUTUBE_API_KEY=

# --- Email de confirmation ---
# SMTP auto-hébergé (aucun service d'envoi externe). Dans le docker-compose, le
# service `mailpit` fournit SMTP (port 1025) + une web UI : http://localhost:8025.
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"
# MAIL_FROM="hubly@localhost"
#
# Destinataire des messages du formulaire /contact (défaut : MAIL_FROM).
# CONTACT_EMAIL="contact@example.com"
#
# Sans SMTP_HOST configuré : pas d'envoi réel — le lien est loggé en console et
# l'API /api/auth/register renvoie alors devConfirmationToken (canal de repli).
