# Variables lues par docker-compose.yml. Copier ce fichier en `.env` (ignoré par
# git) et remplir ce dont vous avez besoin : tout est optionnel, `docker-compose up`
# démarre sans `.env`.
#
# Ne jamais écrire un secret dans docker-compose.yml ou dans un fichier versionné.

# --- Secrets internes -------------------------------------------------------
# Laissés vides, ils sont générés au premier démarrage et conservés dans le
# volume Docker `backend-secrets`. À ne renseigner que pour imposer une valeur
# (openssl rand -base64 32).
# NEXTAUTH_SECRET=
# TOKEN_ENCRYPTION_KEY=

# --- Connexion GitHub / Google (OAuth 2.0) -----------------------------------
# Sans ces identifiants, les boutons GitHub/Google indiquent qu'ils ne sont pas
# configurés ; l'inscription par email et le reste de l'application fonctionnent.
# GitHub : Settings > Developer settings > OAuth Apps
#   Callback URL : http://localhost:8080/api/auth/callback/github
# Google : console.cloud.google.com > APIs & Services > Credentials
#   Redirect URI : http://localhost:8080/api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Clés d'API des services (optionnelles) ----------------------------------
# STEAM_API_KEY=      # https://steamcommunity.com/dev/apikey
# YOUTUBE_API_KEY=    # YouTube Data API v3, console.cloud.google.com

# --- Emails ------------------------------------------------------------------
# Par défaut, les emails arrivent dans Mailpit : http://localhost:8025
# Pour un envoi réel (ex. Gmail avec un mot de passe d'application) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# CONTACT_EMAIL=
