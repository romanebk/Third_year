// GéoEmploi - Schéma de base de données
// PostgreSQL + PostGIS

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOBSEEKER
  EMPLOYER
  ADMIN
}

enum OfferStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
  REPORTED
}

enum ApplicationStatus {
  PENDING
  VIEWED
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  role                Role
  isSuspended         Boolean   @default(false)
  geoConsent          Boolean   @default(false)
  geoConsentUpdatedAt DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  jobseekerProfile JobseekerProfile?
  employerProfile  EmployerProfile?
  applications     Application[]
  notifications    Notification[]
  reports          Report[]
  sessions         Session[]

  @@index([role])
  @@index([isSuspended])
  @@index([deletedAt])
}

model JobseekerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  firstName      String
  lastName       String
  phone          String?
  skills         String[] // compétences (liste)
  experience     String?
  availability   String?
  latitude       Float?
  longitude      Float?
  cvPath         String? // chemin disque local (stockage souverain, pas d'objet managé), jamais exposé tel quel à l'API
  cvOriginalName String?
  cvUploadedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  siret       String?
  verified    Boolean  @default(false)
  description String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers      Offer[]
}

model Offer {
  id           String      @id @default(uuid())
  employerId   String
  title        String
  description  String
  latitude     Float
  longitude    Float
  address      String?
  commune      String?
  radiusKm     Float       @default(10) // périmètre de diffusion
  viewCount    Int         @default(0) // métriques dashboard employeur
  status       OfferStatus @default(ACTIVE)
  // Champs métier alignés sur le frontend (NewOfferPage.tsx), chaînes plutôt
  // qu'enums Prisma : valeurs accentuées (Bâtiment, Santé...) non valides comme
  // identifiants d'enum. Contraintes réelles appliquées côté Zod (offers.schema.ts).
  sector       String? // Restauration | Logistique | Santé | Commerce | Bâtiment | Tech | Services
  contractType String? // CDI | CDD | Intérim | Extra | Alternance | Stage
  salaryMin    Float?
  salaryMax    Float?
  salaryKind   String? // brut | net
  workTime     String?
  // Suggérés par Stella (pas exigés par Florine/Thomas/Benjamin) : niveau
  // d'expérience et compétences recherchées côté offre. Texte libre côté
  // expérience (pas de convention frontend fixée), tableau pour rester
  // cohérent avec JobseekerProfile.skills.
  experienceLevel String?
  requiredSkills  String[] @default([])
  // Traçabilité géocodage (exigence Thomas Vignal) : d'où vient la position,
  // avec quelle confiance, à quelle date. Jamais fourni par le client, toujours
  // renseigné côté serveur au moment du géocodage (offers.routes.ts).
  geocodeSource   String? // "api-adresse"
  geocodeScore    Float? // 0..1, confiance renvoyée par la BAN
  geocodeCitycode String? // code INSEE de la commune résolue
  geocodedAt      DateTime?
  // Précision retenue pour les coordonnées enregistrées (exigence Florine Pontaillac,
  // retour v1.0 du 8 septembre 2026, point 3.2) : toujours "commune" désormais,
  // jamais "adresse". Colonne dédiée pour que ce soit vérifiable sans ambiguïté,
  // indépendamment de geocodeSource qui ne dit que d'où vient l'appel API.
  geocodePrecision String? @default("commune")
  publishedAt  DateTime    @default(now())
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Géolocalisation : lat/lng Prisma (source de vérité modifiable par l'appli) +
  // colonne geography dédiée pour les requêtes PostGIS. Coordonnées stockées en
  // WGS84 ; la conversion Lambert-93 (EPSG:2154) exigée pour l'administration et
  // les exports se fait côté serveur, à la lecture.
  //
  // geoPoint : type Prisma "Unsupported" (Prisma ne modélise pas PostGIS
  // nativement), synchronisé automatiquement depuis latitude/longitude par un
  // trigger PostgreSQL (migration 20260910..._add_geo_point_gist_index), pas par
  // du code applicatif : aucun chemin d'écriture (création, migration IGN, seed)
  // ne peut l'oublier. Index GIST dessus : sans lui, ST_DWithin recalculait
  // ST_MakePoint à la volée sur latitude/longitude à chaque requête, impossible
  // à indexer, confirmé Seq Scan par EXPLAIN ANALYZE (rapport de charge du
  // 3 septembre 2026, jamais corrigé depuis).
  geoPoint Unsupported("geography(Point, 4326)")?

  employer     EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications Application[]
  reports      Report[]

  @@index([status])
  @@index([expiresAt])
  @@index([employerId])
}

model Application {
  id        String            @id @default(uuid())
  offerId   String
  userId    String
  status    ApplicationStatus @default(PENDING)
  message   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  offer     Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([userId])
  @@index([offerId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String // "application_received", "application_status", "alert"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Report {
  id        String       @id @default(uuid())
  offerId   String
  userId    String
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  offer     Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId]) // 1 signalement par offre et par utilisateur
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
