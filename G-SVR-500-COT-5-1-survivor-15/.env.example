# Application
NODE_ENV=development
PORT=3000

# Base de données PostgreSQL + PostGIS (voir docker-compose.yml)
DATABASE_URL=postgresql://geoemploi:geoemploi@localhost:5432/geoemploi

# JWT, remplacer par des secrets forts en production (min. 16 caractères)
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS, origine du frontend React (Vite, port 5173)
CORS_ORIGIN=http://localhost:5173

# URL publique cliquable par un utilisateur (liens dans les e-mails, ex. reset
# de mot de passe). Distincte de CORS_ORIGIN : le frontend local tourne en
# HTTPS (certificat auto-signé), CORS_ORIGIN ne sert qu'à la vérification
# d'origine côté serveur.
APP_URL=https://localhost:5173

# E-mail transactionnel, optionnel. Sans SMTP_HOST, les e-mails sont écrits
# dans backend/mail-outbox/ (.eml) au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GéoEmploi <no-reply@geoemploi.local>

# Géocodage, tous optionnels (valeurs par défaut déjà adaptées à l'API Adresse publique)
GEOCODING_API_URL=https://api-adresse.data.gouv.fr/search/
COMMUNES_API_URL=https://geo.api.gouv.fr/communes
GEOCODING_INTERVAL_MS=120
GEOCODING_MAX_ATTEMPTS=4
GEOCODING_MIN_SCORE=0.4

# Cache de tuiles IGN (proxy backend), optionnel
TILE_CACHE_MAX_ENTRIES=2000
TILE_CACHE_TTL_MS=86400000

# Frontend (Vite, lu au build). Temps réel : websocket par défaut, polling en
# repli automatique si la connexion WebSocket échoue (ou forcé par config ici,
# sans changer le code, si le réseau bloque les WebSockets sortants).
VITE_REALTIME_MODE=websocket
VITE_REALTIME_POLL_MS=8000
